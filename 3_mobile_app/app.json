{
  "expo": {
    "name": "Security Command",
    "slug": "security-command",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": [
      "ios",
      "android"
    ],
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.zney.security",
      "buildNumber": "1",
      "requireFullScreen": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Ứng dụng cần Camera để quét mã QR ghép nối thiết bị.",
        "NSFaceIDUsageDescription": "Dùng để xác thực bảo mật.",
        "UIUserInterfaceStyle": "Dark",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.zney.security",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-camera",
      [
        "expo-notifications",
        {
          "color": "#6C63FF"
        }
      ],
      "expo-asset",
      "expo-web-browser"
    ],
    "scheme": "security-command",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2ba72b20-0edd-45e8-accb-5f0ccf553573"
      }
    },
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/2ba72b20-0edd-45e8-accb-5f0ccf553573"
    }
  }
}
